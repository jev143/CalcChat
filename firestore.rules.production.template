rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This template assumes Firebase Authentication is enabled and request.auth.uid
    // is the same UID stored in ownerUserId/uid. Do not deploy until the app is migrated
    // from the custom Account Code session to Firebase Auth or authenticated server APIs.
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function ownsIdentity() {
      return signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid);
      allow update: if self(uid);
      allow delete: if false;
    }

    match /accountCodes/{code} {
      // Exact-code discovery should be done through an authenticated server endpoint.
      allow read, write: if false;
    }

    match /identities/{identityId} {
      allow read: if signedIn() && (resource.data.ownerUserId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if ownsIdentity() && request.resource.data.ownerUserId == request.auth.uid;
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      }
    }

    match /calls/{callId} {
      allow read, update: if signedIn() && (resource.data.callerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.callerUid == request.auth.uid;
      allow delete: if false;
      match /{document=**} {
        allow read, write: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.receiverUid == request.auth.uid
        );
      }
    }

    match /mediaFiles/{fileId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false; // server-owned metadata
    }

    match /{document=**} { allow read, write: if false; }
  }
}
